{
  "manifest_version": 3,
  "name": "MuffMojo",
  "version": "3.2.0",
  "description": "Type : followed by an emoji name to inject emoji suggestions directly into chat inputs.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "bgremoved.png",
      "48": "bgremoved.png",
      "128": "bgremoved.png"
    },
    "default_title": "MuffMojo inline emoji injector"
  },
  "icons": {
    "16": "bgremoved.png",
    "48": "bgremoved.png",
    "128": "bgremoved.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": [
        "src/muffmojo/data/emoji-dataset.js",
        "src/muffmojo/utils/fuzzySearch.js",
        "src/muffmojo/utils/emojiDataset.js",
        "src/muffmojo/utils/caretPositioning.js",
        "content.js"
      ],
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/muffmojo/website/index.html",
        "src/muffmojo/website/styles.css",
        "bgremoved.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
