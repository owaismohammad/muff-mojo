{
  "manifest_version": 3,
  "name": "Muff-Mojo 🧁",
  "version": "3.0.0",
  "description": "Sprinkle some fun on your chats 🍩 Type a word, get the emoji — on WhatsApp Web and Instagram.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Muff-Mojo",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["emoji-data.js", "emojis.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
