{
  "manifest_version": 3,
  "name": "Muff-Mojo 🧁",
  "version": "1.0",
  "description": "Sprinkle Some Fun on Your Chats 🍩\n\tInteractive browser extension that add expressive emojis to your typing experience.",
 
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://www.instagram.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_logo": "muff64.png"
  },
  "icons": {
    "512": "bgremoved.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://www.instagram.com/*"
      ],
      "js": ["content5.js"]
    }
  ]
}
